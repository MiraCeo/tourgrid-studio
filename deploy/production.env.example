# Host Nginx terminates public TLS and proxies to 127.0.0.1:8081.
TOURGRID_SITE_ADDRESS=:80
TOURGRID_BIND_ADDRESS=127.0.0.1
TOURGRID_HTTP_PORT=8081
TOURGRID_HTTPS_PORT=8444
TOURGRID_ENVIRONMENT=production
TOURGRID_RELEASE=0.3.2
TOURGRID_IMAGE_TAG=0.3.2
TOURGRID_PIP_INDEX_URL=https://pypi.org/simple
TOURGRID_PIP_TIMEOUT=120
TOURGRID_PIP_RETRIES=10
TOURGRID_DB_PASSWORD=replace-with-a-long-random-password
TOURGRID_ADMIN_TOKEN=replace-with-a-different-long-random-token
TOURGRID_ADMIN_AUTH_FAILURE_LIMIT=5
TOURGRID_ADMIN_AUTH_FAILURE_WINDOW_SECONDS=900
TOURGRID_DB_PORT=5432
TOURGRID_VIEW_DEDUPE_SECONDS=1800
TOURGRID_RATE_LIMIT_REQUESTS=20
TOURGRID_RATE_LIMIT_WINDOW_SECONDS=60
TOURGRID_RATE_LIMIT_MAX_CLIENTS=10000
TOURGRID_SENTRY_DSN=
TOURGRID_SENTRY_TRACES_SAMPLE_RATE=0
