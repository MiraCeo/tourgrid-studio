# Local validation: http://localhost:8080
TOURGRID_SITE_ADDRESS=http://
TOURGRID_HTTP_PORT=8080
TOURGRID_HTTPS_PORT=8443
TOURGRID_ENVIRONMENT=development
TOURGRID_RELEASE=local
TOURGRID_IMAGE_TAG=local

# Conversion limits
TOURGRID_MAX_UPLOAD_BYTES=10485760
TOURGRID_MAX_IMAGE_WIDTH=8192
TOURGRID_MAX_IMAGE_HEIGHT=8192
TOURGRID_MAX_IMAGE_PIXELS=25000000
TOURGRID_PROCESSING_TIMEOUT_SECONDS=30
TOURGRID_QUEUE_TIMEOUT_SECONDS=2
TOURGRID_MAX_CONCURRENT_CONVERSIONS=2
TOURGRID_PREVIEW_TTL_SECONDS=300
TOURGRID_PREVIEW_CACHE_ENTRIES=128

# Per-client POST /api/v1/convert limit
TOURGRID_RATE_LIMIT_REQUESTS=10
TOURGRID_RATE_LIMIT_WINDOW_SECONDS=60

# Optional Sentry monitoring; leave empty to disable
TOURGRID_SENTRY_DSN=
TOURGRID_SENTRY_TRACES_SAMPLE_RATE=0
