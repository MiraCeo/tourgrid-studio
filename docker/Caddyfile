{$TOURGRID_SITE_ADDRESS:http://} {
	encode zstd gzip

	request_body {
		max_size {$TOURGRID_PROXY_MAX_BODY_SIZE:128KB}
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	route {
		@backend path /api/* /docs* /openapi.json
		reverse_proxy @backend api:8000 {
			health_uri /api/v1/health
			health_interval 30s
			health_timeout 5s
			transport http {
				response_header_timeout 40s
			}
		}

		root * /srv
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
